# Ambiente local de desenvolvimento.
#   cp .env.example .env && docker compose up
#
# Nenhum valor aqui é segredo de verdade: a senha abaixo só existe dentro do
# compose da máquina do operador. Segredo de produção nunca mora no
# repositório — vem do ambiente (Secret do cluster).

POSTGRES_DB=nudge
POSTGRES_USER=nudge
POSTGRES_PASSWORD=nudge-local-dev-only
POSTGRES_PORT=5432

# Obrigatória e sem valor padrão no aplicativo: sem ela o processo não sobe.
DATABASE_URL=postgresql+psycopg://nudge:nudge-local-dev-only@db:5432/nudge

# Banco usado só pela suíte de testes; criado automaticamente se não existir.
TEST_DATABASE_URL=postgresql+psycopg://nudge:nudge-local-dev-only@db:5432/nudge_test

LOG_LEVEL=INFO
APP_TIMEZONE=America/Sao_Paulo
APP_PORT=8000

# Em produção estes valores vêm do build da imagem (fase 4).
APP_VERSION=0.0.0-dev
APP_COMMIT=local
